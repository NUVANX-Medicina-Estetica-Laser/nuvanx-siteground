{
  "name": "nuvanx-siteground",
  "version": "1.0.0",
  "description": "NUVANX Medical Aesthetics Website & Infrastructure",
  "private": true,
  "scripts": {
    "build:css": "node scripts/build/compile-theme-css.mjs",
    "build": "npm run build:css",
    "lint:colors": "node scripts/lint/no-hardcoded-colors.mjs",
    "lint:fontsize": "node scripts/lint/no-hardcoded-fontsize.mjs",
    "lint:styles": "node scripts/lint/no-inline-layout-styles.mjs",
    "lint:routes": "node scripts/lint/validate-routes-schema.mjs",
    "lint:contrast": "node scripts/lint/test-hero-wcag-contrast.mjs",
    "lint:hook-priorities": "php scripts/lint/test-the-content-hook-priority-registry.php",
    "lint:complianz": "node scripts/lint/test-complianz-a11y-sanitizer.mjs && node scripts/lint/test-complianz-policy-routing.mjs && php scripts/lint/test-complianz-policy-routing.php",
    "lint:schema": "node scripts/lint/test-schema-semantic-contract.mjs && php scripts/lint/test-robots-txt-governance.php && php scripts/lint/test-treatment-faqpage-contract.php",
    "lint:endolaser-approval": "node scripts/lint/test-endolaser-claim-approval.mjs",
    "lint:clinical-evidence": "node scripts/lint/test-clinical-evidence-contract.mjs",
    "lint:clinics-hub-equipment": "node scripts/lint/test-clinics-hub-equipment-contract.mjs",
    "lint:css-ownership": "node scripts/lint/test-css-ownership-contract.mjs",
    "lint:integrations": "node scripts/lint/test-conversion-ownership-contract.mjs && node scripts/lint/test-integration-config-fail-closed.mjs",
    "lint:performance-gate": "node scripts/lint/test-performance-regression-policy.mjs",
    "lint:manifest": "node scripts/lint/test-css-manifest-contract.mjs && php scripts/lint/test-cases-publication-policy.php && npm run lint:css-ownership && npm run lint:integrations && npm run lint:performance-gate",
    "lint": "npm run lint:colors && npm run lint:fontsize && npm run lint:styles && npm run lint:routes && npm run lint:contrast && npm run lint:hook-priorities && npm run lint:complianz && npm run lint:schema && npm run lint:endolaser-approval && npm run lint:clinical-evidence && npm run lint:clinics-hub-equipment && npm run lint:manifest"
  },
  "engines": {
    "node": ">=18"
  }
}
