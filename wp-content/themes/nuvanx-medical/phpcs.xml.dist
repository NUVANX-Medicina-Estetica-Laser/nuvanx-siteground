<?xml version="1.0"?>
<ruleset name="Nuvanx Medical Theme">
    <description>Portable PHP_CodeSniffer baseline for the NUVANX theme.</description>

    <file>.</file>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/tests/*</exclude-pattern>

    <arg value="ps"/>
    <arg name="parallel" value="8"/>
    <arg name="extensions" value="php"/>
    <config name="ignore_warnings_on_exit" value="1"/>

    
    <!-- Base standard -->
    <rule ref="WordPress">
        <!-- Demote all WPCS errors to warnings temporarily for controlled evolution -->
        <type>warning</type>
        <exclude name="WordPress.WP.I18n.MissingTranslatorsComment"/>

    </rule>

    <!-- Specific enforced rules for integrity -->
    <rule ref="Generic.Files.ByteOrderMark"><type>error</type></rule>
    <rule ref="Generic.Files.EndFileNewline"><type>error</type></rule>
    <rule ref="Generic.PHP.DisallowShortOpenTag"><type>error</type></rule>
    <rule ref="Generic.PHP.DeprecatedFunctions"><type>error</type></rule>
    <rule ref="Generic.CodeAnalysis.EmptyStatement"><type>error</type></rule>
    <rule ref="Generic.CodeAnalysis.UnconditionalIfStatement"><type>error</type></rule>
    <rule ref="Generic.CodeAnalysis.UselessOverridingMethod"><type>error</type></rule>
    <rule ref="Squiz.PHP.NonExecutableCode"><type>error</type></rule>
</ruleset>
